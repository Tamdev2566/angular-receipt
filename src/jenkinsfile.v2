pipeline {
    agent none

    environment {
        // Container env:
        IMAGE_TAG = "${BUILD_VERSION}"
        IMAGE_NAME = "${env.NEXUS_REGISTRY}/glossys-ui"
        CONTAINER_NAME = 'glossys-ui'
    }

    stages {
        stage("INITIALIZATION") {
            steps {
                script {
                    currentBuild.displayName = "Build $BUILD_VERSION"
                    if (env.APP_VERSION == "") {
                        def now = new Date()
                        env.APP_VERSION = "Glossys Staging " + now.format("ddMMMyyyy HH:mm", TimeZone.getTimeZone("Asia/Singapore")) + " SGT"
                    }
                }
            }
        }

        stage('BUILD') {
            agent { label 'BUILD-NODE' }

            stages {
                stage('Checkout') {
                    steps {
                        // Pull code from repository:
                        git(
                            url: 'https://bitbucket.org/glossys123/glossys_ui.git',
                            credentialsId: 'Bitbucket credentials',
                            branch: 'master'
                        )
                    }
                }

                /*
                stage('Test') {
                }
                */

                stage('Build OCI-compliant image') {
                    steps {
                        // Build Docker image:
                        //sh "docker build -f Dockerfile -t $IMAGE_NAME:latest ."
                        sh "docker build -f Dockerfile -t $IMAGE_NAME:$IMAGE_TAG ."
                    }
                }

                stage('Push image to registry') {
                    steps {
                        // Tag image:
                        //sh "docker tag $IMAGE_NAME:latest $IMAGE_NAME:$IMAGE_TAG"

                        // Push image to Nexus:
                        //sh "docker push $IMAGE_NAME:latest"
                        sh "docker push $IMAGE_NAME:$IMAGE_TAG"
                    }
                }
            }
        }

        stage('DEPLOY') {
            agent { label 'STAGING-01' }

            stages {
                stage('Pull image') {
                    steps {
                        sh "docker pull $IMAGE_NAME:$IMAGE_TAG"
                    }
                }

                stage('Deploy service') {
                    environment {
                        // Host env:
                        HOST_PORT = '8081'
                        HOST_DOWNLOADABLES_DIR = '/var/www/html/download'

                        // Container env:
                        PORT = '80'
                        RESOURCES_DIR = '/usr/share/nginx/html'
                        DOWLOADABLES_DIR = "$RESOURCES_DIR/download"
                    }

                    steps {
                        // Delete old container:
                        sh "docker rm -f $CONTAINER_NAME"

                        // Create config.json for specified environment:
                        script {
                            def config = [
                                'BASE_API': 'https://staging-api-glossys.samudera.id',
                                'BASE_UPLOAD_DIR': '/tmp',
                                'standalone': [[]],
                                'jasperUrl': 'https://staging-glossys.samudera.id:8443',
                                'getPDFUrl': 'https://staging-api-glossys.samudera.id',
                                'pdfUrl': 'https://staging-glossys.samudera.id',
                                'server': 'PRODUCTIONSTG',
                                'title': "${APP_VERSION}",
                                'dashboardUrl': 'https://staging-glossys.samudera.id',
                                'doReleaseUrl' : 'https://ssl-do-release.samudera.id'
                            ]

                            writeJSON(file: "$WORKSPACE/targeted-config.json", json: config)
                        }

                        // Run new container:
                        sh '''
                            docker run -d \
                            -p $HOST_PORT:$PORT \
                            -v $HOST_DOWNLOADABLES_DIR:$DOWLOADABLES_DIR \
                            -v $WORKSPACE/targeted-config.json:$RESOURCES_DIR/config.json \
                            --name=$CONTAINER_NAME $IMAGE_NAME:$IMAGE_TAG
                        '''
                    }
                }
            }
        }
    }
}
